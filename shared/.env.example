# === General ===
DOMAIN=example.com
ACME_EMAIL=admin@example.com
TZ=America/Bogota

# === Traefik ===
TRAEFIK_DASHBOARD_USER=admin
# Generado con: echo $(htpasswd -nB admin) | sed -e s/\\$/\\$\\$/g
TRAEFIK_DASHBOARD_PASSWORD=$2y$$05$$xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# === Grafana ===
GF_SECURITY_ADMIN_USER=admin
GF_SECURITY_ADMIN_PASSWORD=changeme

# === Portainer ===
# El password se configura en el primer acceso via UI

# === PostgreSQL (databases/) ===
POSTGRES_USER=david
POSTGRES_PASSWORD=change_me_strong_password
POSTGRES_DB=mundo_stem

# === pgAdmin ===
PGADMIN_DEFAULT_EMAIL=admin@example.com
PGADMIN_DEFAULT_PASSWORD=change_me_admin_password

# === n8n ===
# Para local: n8n.127.0.0.1.nip.io | Para producción: n8n.${DOMAIN}
N8N_HOST=n8n.127.0.0.1.nip.io
N8N_PORT=5678
N8N_PROTOCOL=http
N8N_SECURE_COOKIE=false
NODE_ENV=production
WEBHOOK_URL=http://n8n.127.0.0.1.nip.io/
GENERIC_TIMEZONE=America/Bogota

# === n8n — PostgreSQL ===
N8N_DB_HOST=postgres
N8N_DB_PORT=5432
N8N_DB_NAME=n8n
N8N_DB_USER=n8n
N8N_DB_PASSWORD=change_me_n8n_password
